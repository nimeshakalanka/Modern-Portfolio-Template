# Copy to .env.local and fill in.

# Web3Forms access key (free at https://web3forms.com). Web3Forms keys are
# designed to be used from the browser, so the NEXT_PUBLIC_ prefix is intended.
NEXT_PUBLIC_WEB3FORMS_KEY=

# Public URL of the deployed site, used for canonical URLs, Open Graph and the sitemap.
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# Set to "off" to force the CSS glass fallback everywhere (the WebGL liquid glass is skipped).
NEXT_PUBLIC_LIQUID_GLASS=on
